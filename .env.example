# Copie este arquivo para .env e ajuste os valores.
# Em desenvolvimento nenhuma variável é obrigatória (SQLite + DEBUG ligado).

# "production" desliga o DEBUG e exige PostgreSQL
DJANGO_ENV=development

# Obrigatório em produção — gere com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Botão "Entrar como visitante" (acesso somente leitura a uma clínica de demonstração)
DJANGO_MODO_VISITANTE=true

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de produção (PostgreSQL)
# DATABASE_URL=postgres://usuario:senha@host:5432/vittas
# DB_SSLMODE=require

# Opcional: CDN para arquivos estáticos
# DJANGO_STATIC_HOST=
